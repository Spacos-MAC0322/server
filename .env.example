# Copie para .env (nesta pasta server) e ajuste. A API, o start.sh e os comandos
# do banco carregam este arquivo como dados; variaveis do terminal tem prioridade.
# Valores omitidos usam os padroes descritos no README. Nunca versione o .env.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGODB_DB_NAME=spacos
# Opcional: banco para os testes de integracao (vazio = ignorados)
MONGODB_TEST_URI=

# API local (start.sh)
API_HOST=127.0.0.1
API_PORT=8000
# Origens do frontend autorizadas (CORS), separadas por virgula; '*' nao e aceito.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autenticacao. JWT_SECRET e obrigatorio para iniciar a API (minimo 32 caracteres).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio: o start.sh usa um segredo temporario e os logins expiram a cada reinicio.
JWT_SECRET=
# Validade do token de login, em minutos (1440 = 1 dia).
JWT_EXPIRE_MINUTES=1440
AUTH_ENABLED=false

# APIs externas
EXTERNAL_API_TIMEOUT_SECONDS=10
MAPAS_CULTURAIS_ENABLED=false
MAPAS_CULTURAIS_BASE_URL=
GEOSAMPA_ENABLED=false
GEOSAMPA_BASE_URL=
SPTRANS_ENABLED=false
SPTRANS_BASE_URL=
SPTRANS_TOKEN=
OPEN_METEO_ENABLED=false
OPEN_METEO_BASE_URL=https://api.open-meteo.com
