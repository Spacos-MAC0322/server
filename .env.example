# Copie para .env e ajuste. O start.sh NAO carrega .env automaticamente:
# exporte as variaveis no terminal (ex.: `set -a; source .env; set +a`).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=spacos

# Segredo para assinar os tokens JWT. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<gere-um-segredo>
# Validade do token de login, em minutos (padrao: 1440 = 1 dia).
JWT_EXPIRE_MINUTES=1440
